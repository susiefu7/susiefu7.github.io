{
  "name": "long-picture-editorial-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "The Long Picture \u2014 Editorial Workspace. A local-first manuscript editor with Git-backed version history, editorial comments and read-only canon.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "init-project": "tsx scripts/init-project.ts",
    "demo": "tsx scripts/demo.ts",
    "import": "tsx scripts/import.ts",
    "backup": "tsx scripts/backup.ts",
    "export": "tsx scripts/export.ts"
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "diff": "^8.0.4",
    "express": "^5.1.0",
    "marked": "^15.0.12",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9",
    "vite": "^5.4.21"
  }
}
